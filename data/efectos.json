    { "id": "defensa", "nombre": "Defensa" },
    { "id": "salvaciones", "nombre": "Salvaciones" },
    { "id": "ataque", "nombre": "Ataque e iniciativa" },
    { "id": "movimiento", "nombre": "Movimiento" },
    { "id": "habilidades", "nombre": "Habilidades" },
    { "id": "magia", "nombre": "Lanzamiento" },
    { "id": "vitalidad", "nombre": "Vitalidad" },
    { "id": "resistencias", "nombre": "Inmunidades y resistencias" },
    { "id": "capacidades", "nombre": "Capacidades" }
  ],
